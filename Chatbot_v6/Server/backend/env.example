# Django 설정
ENVIRONMENT=development
# Generate a unique value with a secret manager; do not commit the real value.
SECRET_KEY=<SET_IN_SECRET_MANAGER>
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# 데이터베이스 설정
MYSQL_DATABASE=chatbot_db
MYSQL_USER=chatbot_user
# Generate unique values with a secret manager; do not commit the real values.
MYSQL_PASSWORD=<SET_IN_SECRET_MANAGER>
MYSQL_ROOT_PASSWORD=<SET_IN_SECRET_MANAGER>
MYSQL_HOST=localhost
MYSQL_PORT=3306

# 챗봇 서버 설정
CHATBOT_URL=http://localhost:8000

# CORS 설정
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=True

# 개발 환경에서만 loopback 익명 채팅을 허용하려면 명시적으로 활성화
CHATBOT_ALLOW_ANONYMOUS_LOCAL=True
