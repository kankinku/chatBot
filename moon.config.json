{
  "schemaVersion": 1,
  "validation": {
    "profileOrder": ["fast", "normal", "release"],
    "profiles": {
      "fast": [
        "python3 tools/validate.py compile"
      ],
      "normal": [
        "python3 tools/validate.py compile",
        "python3 tools/validate.py test"
      ],
      "release": [
        "python3 tools/validate.py compile",
        "python3 tools/validate.py test"
      ]
    },
    "riskProfiles": {
      "low": "fast",
      "medium": "normal",
      "high": "release"
    }
  },
  "risk": {
    "highPathPatterns": [
      "^\\.github/workflows/",
      "^moon\\.config\\.json$",
      "^tools/validate\\.py$",
      "^Chatbot_v6/Server/backend/.*/(auth|security|settings|urls|models|migrations?)(/|\\.|$)",
      "^services/gateway/.*/(auth|security|settings|urls|models|migrations?)(/|\\.|$)",
      "^(Chatbot_v6/)?docker-compose\\.ya?ml$",
      "^deploy/compose/docker-compose\\.ya?ml$"
    ],
    "mediumPathPatterns": [
      "^Chatbot_v6/modules/",
      "^Chatbot_v6/api/",
      "^Chatbot_v6/tests/",
      "^Chatbot_v6/requirements",
      "^src/chatbot/",
      "^services/inference/",
      "^apps/web/",
      "^config/",
      "^tests/",
      "^requirements",
      "^pyproject\\.toml$",
      "^package\\.json$",
      "^docs/"
    ]
  },
  "knowledge": {
    "maxPermanentDocs": 50,
    "ephemeralPatterns": [
      "^docs/(?:plans?|specs?)/",
      "^docs/modernization/"
    ],
    "generatedPatterns": [
      "^\\.moon/"
    ]
  }
}
