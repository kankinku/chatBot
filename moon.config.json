{
  "schemaVersion": 1,
  "validation": {
    "profileOrder": ["fast", "normal", "release"],
    "profiles": {
      "fast": [
        "python -m compileall -q Server/backend tests/unit modules config scripts"
      ],
      "normal": [
        "python -m compileall -q Server/backend tests/unit modules config scripts",
        "python -m pytest tests/unit -q -o addopts= -p no:cacheprovider"
      ],
      "release": [
        "python -m compileall -q Server/backend tests/unit modules config scripts",
        "python -m pytest tests/unit -q -o addopts= -p no:cacheprovider"
      ]
    },
    "riskProfiles": {
      "low": "fast",
      "medium": "normal",
      "high": "release"
    }
  },
  "risk": {
    "highPathPatterns": [
      "^\\.github/workflows/",
      "^moon\\.config\\.json$",
      "^Chatbot_v6/Server/backend/.*/(auth|security|settings|urls|models|migrations?)(/|\\.|$)",
      "^Chatbot_v6/docker-compose\\.ya?ml$"
    ],
    "mediumPathPatterns": [
      "^Chatbot_v6/modules/",
      "^Chatbot_v6/tests/",
      "^Chatbot_v6/requirements",
      "^docs/"
    ]
  },
  "knowledge": {
    "maxPermanentDocs": 50,
    "ephemeralPatterns": [
      "^docs/(?:plans?|specs?)/",
      "^docs/modernization/"
    ],
    "generatedPatterns": [
      "^\\.moon/"
    ]
  }
}
